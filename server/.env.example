# ===== GadgetKu =====
PORT=3000
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Email untuk 3 akun contoh saat seed.
SEED_ADMIN_EMAIL=admin@gadgetku.id
SEED_SELLER_EMAIL=seller@gadgetku.id
SEED_PEMBELI_EMAIL=pembeli@gadgetku.id

# Password untuk 3 akun contoh saat seed (minimal 6 karakter).
# Hanya dipakai ketika database dibuat/di-seed ulang.
SEED_PASSWORD=

# Mode database: sqlite (dev, tanpa setup) | mysql (produksi)
DB_CLIENT=sqlite

# Konfigurasi MySQL (dipakai hanya jika DB_CLIENT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gadgetku
